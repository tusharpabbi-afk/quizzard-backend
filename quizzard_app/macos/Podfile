platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      # Align with Xcode-supported minimum for macOS.
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.13'
    end

    # Remove invalid clang flag from BoringSSL-GRPC sources.
    if target.name == 'BoringSSL-GRPC'
      target.build_phases.each do |phase|
        next unless phase.respond_to?(:files)

        phase.files.each do |build_file|
          next unless build_file.settings&.[]('COMPILER_FLAGS')

          flags = build_file.settings['COMPILER_FLAGS']
          cleaned = flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').strip
          build_file.settings['COMPILER_FLAGS'] = cleaned
        end
      end
    end

    if target.name.start_with?('gRPC')
      target.build_configurations.each do |config|
        flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        unless flags.include?('-Wno-missing-template-arg-list-after-template-kw')
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{flags} -Wno-missing-template-arg-list-after-template-kw"
        end
      end
    end

    # Silence Xcode warning about missing script outputs in Pods.
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:name) && phase.name == 'Create Symlinks to Header Folders'

      phase.output_paths ||= []
      stamp = "$(DERIVED_FILE_DIR)/#{target.name}-symlinks.stamp"
      phase.output_paths << stamp unless phase.output_paths.include?(stamp)
    end
  end

end